CREATE TABLE Habit (
  id          TEXT NOT NULL PRIMARY KEY,
  name        TEXT NOT NULL,
  iconKey     TEXT NOT NULL,
  categoryId  TEXT NOT NULL REFERENCES Category(id),
  createdOn   TEXT NOT NULL
);

selectAllWithCategory:
SELECT h.id, h.name, h.iconKey, h.createdOn,
       c.id AS categoryId, c.name AS categoryName, c.colorKey, c.sortOrder
FROM Habit h JOIN Category c ON c.id = h.categoryId
ORDER BY h.createdOn, h.name;

selectOneWithCategory:
SELECT h.id, h.name, h.iconKey, h.createdOn,
       c.id AS categoryId, c.name AS categoryName, c.colorKey, c.sortOrder
FROM Habit h JOIN Category c ON c.id = h.categoryId
WHERE h.id = ?;

insert:
INSERT INTO Habit(id, name, iconKey, categoryId, createdOn) VALUES (?, ?, ?, ?, ?);

updateDetails:
UPDATE Habit SET name = ?, iconKey = ?, categoryId = ? WHERE id = ?;

deleteById:
DELETE FROM Habit WHERE id = ?;

countByCategory:
SELECT COUNT(*) FROM Habit WHERE categoryId = ?;
